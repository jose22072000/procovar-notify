# ─────────────────────────────────────────────────────────────────────────────
# App BACKEND  (deploy/Dockerfile.backend) — HTTP público del v2.
# PUERTO A EXPONER en Dokploy:  8080  (API_PORT)
# Copia estas variables en la app "backend" de Dokploy y rellena los valores reales.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEBUG=false
API_PORT=8080

# --- PostgreSQL (usa tu Postgres gestionado; sslmode según el proveedor) ---
DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/qbnotify?sslmode=require

# --- Redis / colas ---  Usa UNO de los dos bloques (Sentinel o nodo único).
# Sentinel (HA, recomendado):
REDIS_SENTINELS=host1:26379,host2:26379,host3:26379
REDIS_MASTER_NAME=master
REDIS_SENTINEL_PASSWORD=
REDIS_PASSWORD=
# Nodo único (deja REDIS_SENTINELS vacío y descomenta):
#REDIS_ADDR=redis:6379
REDIS_DB_DEFAULT=4
REDIS_DB_LOCKS=5
REDIS_DB_ASYNQ=10
REDIS_PREFIX=qb-notify

# --- Cripto / auth (GENERA valores propios; no reutilices ejemplos) ---
#   SECRET_ENCRYPTION_KEY : openssl rand -base64 32   (32 bytes)
#   ADMIN_JWT_SECRET      : openssl rand -base64 48   (mín. 32 caracteres)
SECRET_ENCRYPTION_KEY=CAMBIA_ESTO_base64_de_32_bytes
SECRET_ENCRYPTION_KEY_VERSION=1
#SECRET_ENCRYPTION_KEYS=1:<clave-anterior-base64>   # solo para rotación de claves
ADMIN_JWT_SECRET=CAMBIA_ESTO_minimo_32_caracteres

# --- HMAC de la API pública ---
HMAC_TIMESTAMP_SKEW_SECONDS=300

# --- CORS (admin API) ---  El SPA (app "web") es público y llama a /admin
# directo desde el navegador, sin proxy delante: sin esto, el navegador
# bloquea la petición. Lista separada por comas de orígenes exactos (con
# esquema, sin barra final).
CORS_ALLOWED_ORIGINS=https://web.tu-dominio.com

# --- Reverse proxy ---  Actívalo solo si el api va detrás de un proxy de confianza
# (para derivar la IP del cliente de X-Forwarded-For).
#TRUST_PROXY_HEADERS=true

# --- Bootstrap al arrancar ---
# El api aplica las migraciones al arrancar y, si la BD está LIMPIA (sin admins),
# siembra el super-admin + las 25 plantillas base. Se puede desactivar con:
#AUTO_MIGRATE=false
#AUTO_SEED=false
# El super-admin del PRIMER arranque (solo se usa si la BD está limpia):
SEED_ADMIN_EMAIL=admin@tu-dominio.com
SEED_ADMIN_PASSWORD=CAMBIA_ESTO_contraseña_fuerte
