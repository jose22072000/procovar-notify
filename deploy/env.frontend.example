# ─────────────────────────────────────────────────────────────────────────────
# App FRONTEND  (deploy/Dockerfile.frontend) — SPA de administración servida por nginx.
# PUERTO A EXPONER en Dokploy:  50001 (WEB_PORT)
#   nginx solo sirve estáticos (sin proxy); el navegador llama directo al
#   backend público.
# ─────────────────────────────────────────────────────────────────────────────

WEB_PORT=50001

# VITE_API_URL es un BUILD ARG, no una env var de runtime (Vite lo hornea en
# el bundle JS al compilar). Configúralo en Dokploy como "Build Argument", no
# como variable de entorno de la app:
#   VITE_API_URL=https://api.tu-dominio.com
#
# Recuerda además configurar CORS_ALLOWED_ORIGINS en la app "backend" (ver
# env.backend.example) con la URL pública de ESTA app frontend, o el navegador
# bloqueará las peticiones a /admin.
