# ─────────────────────────────────────────────────────────────────────────────
# App SERVICES  (deploy/Dockerfile.services) — procesa la cola de envío (asynq).
# PUERTO A EXPONER en Dokploy:  9091  (METRICS_PORT, métricas Prometheus).
#   No expone HTTP público; solo el endpoint /metrics para el scrape.
# IMPORTANTE: comparte Postgres, Redis y CLAVES con el backend (misma BD, mismo cifrado).
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEBUG=false
WORKER_CONCURRENCY=10
METRICS_PORT=9091
QUEUE_RETRY_MAX=3

# --- PostgreSQL (el MISMO que el backend) ---
DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/qbnotify?sslmode=require

# --- Redis / colas (el MISMO que el backend) ---
REDIS_SENTINELS=host1:26379,host2:26379,host3:26379
REDIS_MASTER_NAME=master
REDIS_SENTINEL_PASSWORD=
REDIS_PASSWORD=
#REDIS_ADDR=redis:6379
REDIS_DB_DEFAULT=4
REDIS_DB_LOCKS=5
REDIS_DB_ASYNQ=10
REDIS_PREFIX=qb-notify

# --- Cripto / auth (los MISMOS valores que el backend) ---
SECRET_ENCRYPTION_KEY=CAMBIA_ESTO_base64_de_32_bytes
SECRET_ENCRYPTION_KEY_VERSION=1
#SECRET_ENCRYPTION_KEYS=1:<clave-anterior-base64>
# ADMIN_JWT_SECRET lo EXIGE la validación de arranque (aunque el worker no use JWT):
ADMIN_JWT_SECRET=CAMBIA_ESTO_minimo_32_caracteres

# --- Guardas anti-SSRF (por defecto se bloquean destinos internos) ---
# Adjuntos por URL:
#ATTACHMENT_ALLOW_PRIVATE=false
#ATTACHMENT_HOST_ALLOWLIST=cdn.tu-dominio.com,assets.tu-dominio.com
# Entrega de webhooks:
#WEBHOOK_ALLOW_PRIVATE=false
