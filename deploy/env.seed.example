# ─────────────────────────────────────────────────────────────────────────────
# OPCIONAL — solo para ejecutar migraciones/seed A MANO.
#
# NORMALMENTE NO HACE FALTA: el api aplica las migraciones al arrancar y siembra
# el super-admin + las 25 plantillas base si la BD está limpia (ver env.api.example:
# AUTO_MIGRATE / AUTO_SEED / SEED_ADMIN_*).
#
# Usa esto solo si quieres correr `cmd/migrate` o `cmd/seed` por tu cuenta (p. ej.
# re-sembrar las plantillas base tras añadir nuevas). migrate necesita solo
# DATABASE_URL; seed necesita además el cifrado y las SEED_*.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/qbnotify?sslmode=require

# Cifrado (el seed guarda secretos cifrados → mismos valores que api/worker):
SECRET_ENCRYPTION_KEY=CAMBIA_ESTO_base64_de_32_bytes
SECRET_ENCRYPTION_KEY_VERSION=1

# Fuera de desarrollo el seed EXIGE estas (no crea credenciales conocidas):
SEED_ADMIN_EMAIL=admin@tu-dominio.com
SEED_ADMIN_PASSWORD=CAMBIA_ESTO_contraseña_fuerte
SEED_API_KEY_SECRET=CAMBIA_ESTO_secreto_api_key
#SEED_SMTP_HOST=smtp.tu-proveedor.com
