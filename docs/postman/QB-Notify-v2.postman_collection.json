        {
          "name": "whoami",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK — firma válida', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "whoami"
              ]
            },
            "description": "Identidad del tenant autenticado. Úsalo como smoke test de la firma HMAC: si responde 200, keyId/apiSecret están bien configurados."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notificaciones",
      "item": [
        {
          "name": "Crear (por tipo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "const json = pm.response.json();",
                  "if (json && json.id) { pm.collectionVariables.set('notificationId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"{{notificationType}}\",\n  \"recipient\": {\n    \"email\": \"destinatario@ejemplo.com\",\n    \"name\": \"Ana Pérez\"\n  },\n  \"recipientUserId\": \"{{userId}}\",\n  \"payload\": {\n    \"nombre\": \"Ana\"\n  },\n  \"priority\": \"NORMAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
