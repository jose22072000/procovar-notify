                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateKey\": \"welcome\",\n  \"notificationType\": \"bienvenida\",\n  \"channel\": \"EMAIL\",\n  \"recipient\": {\n    \"email\": \"destinatario@ejemplo.com\"\n  },\n  \"payload\": {\n    \"nombre\": \"Ana\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notifications"
              ]
            },
            "description": "Modo legado: plantilla (`templateKey`), tipo y canal explícitos, sin pasar por un Tipo de notificación configurado. Scope: notifications:send."
          },
          "response": []
        },
        {
          "name": "Crear programada (scheduledAt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });",
                  "const json = pm.response.json();",
                  "if (json && json.id) { pm.collectionVariables.set('notificationId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"{{notificationType}}\",\n  \"recipient\": {\n    \"email\": \"destinatario@ejemplo.com\"\n  },\n  \"payload\": {\n    \"nombre\": \"Ana\"\n  },\n  \"scheduledAt\": \"2026-12-31T09:00:00Z\",\n  \"idempotencyKey\": \"demo-programada-001\"\n}",
