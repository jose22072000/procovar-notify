# QB Notify v2 — variables de entorno (12-factor).
# Copia este archivo a .env y ajústalo. Los valores por defecto casan con el
# entorno local de deploy/docker-compose.yml.

# --- Servidor ---
APP_ENV=development
DEBUG=true
API_PORT=8080
WORKER_CONCURRENCY=10
METRICS_PORT=9091   # puerto de métricas Prometheus del worker

# --- PostgreSQL ---
DATABASE_URL=postgres://qbnotify:qbnotify@localhost:55432/qbnotify?sslmode=disable
# Pool de conexiones (default 20/2). Sin fijarlo, pgx usaría max(4, nCPU):
# insuficiente para WORKER_CONCURRENCY goroutines y serializa bajo carga.
#DB_MAX_CONNS=20
#DB_MIN_CONNS=2

# --- Redis / colas ---
# Modo Sentinel (recomendado; lo provee el compose local en Linux):
REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
REDIS_MASTER_NAME=master
REDIS_SENTINEL_PASSWORD=
REDIS_PASSWORD=
#
# Alternativa nodo único (macOS/Windows o si no quieres Sentinel en local).
# Deja REDIS_SENTINELS vacío y descomenta:
# REDIS_ADDR=localhost:6379
#
REDIS_DB_DEFAULT=4
REDIS_DB_LOCKS=5
REDIS_DB_ASYNQ=10
REDIS_PREFIX=qb-notify

# --- Cripto / auth ---
# Clave AES-256-GCM: 32 bytes en base64. GENERA UNA PROPIA, no uses esta.
#   openssl rand -base64 32
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Rotación de claves (KMS): versión de la clave primaria (con la que se cifra) y
# claves antiguas solo-descifrado, en formato "version:base64,version:base64".
# Para rotar: sube la versión, pon la nueva clave en SECRET_ENCRYPTION_KEY, mueve
# la anterior a SECRET_ENCRYPTION_KEYS, reinicia y ejecuta `make reencrypt`.
SECRET_ENCRYPTION_KEY_VERSION=1
#SECRET_ENCRYPTION_KEYS=1:<clave-anterior-base64>
# Mínimo 32 bytes (256 bits). Genera uno real: openssl rand -base64 48
ADMIN_JWT_SECRET=cambia-esto-en-produccion-usa-min-32-bytes

# --- Cookie del refresh token (panel admin) ---
# El refresh token del panel viaja en una cookie HttpOnly (inaccesible a JS).
# Sus atributos dependen de la topología de despliegue:
#   · Panel y API en el MISMO dominio (o un reverse proxy los une):
#       COOKIE_SAMESITE=lax  COOKIE_SECURE=true  (deja COOKIE_DOMAIN vacío)
#   · Panel y API en DOMINIOS DISTINTOS (ej. panel.x.com y api.y.com):
#       COOKIE_SAMESITE=none COOKIE_SECURE=true  (obligatorio HTTPS)
#       + añade el origen del panel a CORS_ALLOWED_ORIGINS
# En dev (proxy de Vite, mismo origen sobre http) los defaults valen tal cual.
COOKIE_REFRESH_NAME=qbn_refresh
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=            # vacío = host-only (recomendado en mismo dominio)
# CORS_ALLOWED_ORIGINS=https://panel.tu-dominio.com   # solo si el panel está en otro origen

# --- Defaults de cola / HMAC ---
# Reintentos por notificación (fallos normales; con el proveedor caído se
# reintenta con retardo SIN consumir estos intentos).
QUEUE_RETRY_MAX=3
# Orden estricto de colas (default true): critical SIEMPRE antes que default/low
# (un pico de masivos no retrasa un OTP). false = reparto ponderado 6/3/1.
#QUEUE_STRICT_PRIORITY=true
# Drenado máximo al apagar el worker (default 30 s; debe superar al canal más
# lento para que un deploy no corte envíos en vuelo).
#QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
HMAC_TIMESTAMP_SKEW_SECONDS=300

# --- SMTP local (MailHog) — usado a partir de la Fase 3 ---
# MailHog acepta correo en localhost:1025 y lo muestra en http://localhost:8025

# --- Adjuntos por URL (seguridad anti-SSRF) — worker ---
# Por defecto se bloquean destinos loopback/privados/link-local (resueltos por IP).
# ATTACHMENT_ALLOW_PRIVATE=true los permite (solo entornos cerrados de confianza).
#ATTACHMENT_ALLOW_PRIVATE=false
# Allowlist opcional de hosts: si se define, solo se descargan adjuntos de esos
# hosts (defensa en profundidad). Coma-separada; vacío = sin restricción por host.
#ATTACHMENT_HOST_ALLOWLIST=cdn.tu-dominio.com,assets.tu-dominio.com

# --- Entrega de webhooks (seguridad anti-SSRF) — worker ---
# Por defecto se bloquean destinos internos (loopback/privados/link-local).
# WEBHOOK_ALLOW_PRIVATE=true los permite (self-hosted con el backend del cliente
# en la misma red privada).
#WEBHOOK_ALLOW_PRIVATE=false

# --- Seed (datos iniciales) ---
# En desarrollo (APP_ENV=development) se usan valores por defecto. FUERA de
# desarrollo, el seed EXIGE estas variables (no crea credenciales conocidas).
#SEED_ADMIN_EMAIL=admin@tu-dominio.com
#SEED_ADMIN_PASSWORD=<contraseña-fuerte>
#SEED_API_KEY_SECRET=<secreto-api-key-demo>
